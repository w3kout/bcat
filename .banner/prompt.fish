# BCAT prompt (fish) - generated by bcat.py
function __bcat_git
    set -l b (command git symbolic-ref --short -q HEAD 2>/dev/null)
    test -n "$b"; and printf ' (%s)' $b
end

function fish_prompt
    set -l last $status
    set_color --bold magenta
    printf '%s' '▁▂▃ '
    set_color --bold brmagenta
    printf '%s' 'silent'
    printf '%s' ' '
    set_color --bold magenta
    printf '%s' '▃▂▁ '
    set_color --bold brcyan
    printf '%s' (string replace -r -- "^$HOME" '~' $PWD)
    set_color --bold yellow
    __bcat_git
    echo
    set_color --bold magenta
    printf '%s' '⟩ '
    if test $last -eq 0
        set_color --bold green
    else
        set_color --bold red
    end
    set_color normal
end
