# BCAT prompt (zsh) - generated by bcat.py
setopt PROMPT_SUBST
autoload -Uz add-zsh-hook
__bcat_git() {
    local b
    b=$(command git symbolic-ref --short -q HEAD 2>/dev/null) || return 0
    [[ -n $b ]] && print -rn -- " ($b)"
    return 0
}
__bcat_precmd() {
    PROMPT='%B%F{5}▁▂▃ %F{13}silent %F{5}▃▂▁ %F{14}%~%F{3}$(__bcat_git)
%F{5}⟩ %(?.%F{2}.%F{1})%b%f'
    RPROMPT=''
}
add-zsh-hook -d precmd __bcat_precmd 2>/dev/null
add-zsh-hook precmd __bcat_precmd
