
#!/usr/bin/env bash
set -u

printf '\033[2J\033[H'

BCAT_DIR="$HOME/.bcat"
WANT_ZSH=0
WANT_FISH=0

for arg in "$@"; do
  case "$arg" in
    --zsh) WANT_ZSH=1 ;;
    --fish) WANT_FISH=1 ;;
    --all) WANT_ZSH=1; WANT_FISH=1 ;;
    -h|--help) echo "Usage: bash install [--zsh] [--fish] [--all]"; exit 0 ;;
    *) echo "Unknown option: $arg"; exit 1 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

is_termux() {
  [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux ]
}

detect_pm() {
  if is_termux; then echo pkg
  elif [ "$(uname -s)" = "Darwin" ]; then
    if have brew; then echo brew; else echo none; fi
  elif have apt-get; then echo apt
  elif have pacman; then echo pacman
  elif have dnf; then echo dnf
  elif have zypper; then echo zypper
  elif have apk; then echo apk
  else echo none
  fi
}

PM="$(detect_pm)"
SUDO=""

if [ "$PM" != "pkg" ] && [ "$PM" != "brew" ] && [ "$(id -u)" -ne 0 ] && have sudo; then
  SUDO="sudo"
fi

if is_termux; then
  BIN_DIR="${PREFIX:-/data/data/com.termux/files/usr}/bin"
else
  BIN_DIR="$HOME/.local/bin"
fi

BCAT_SRC=""

if [ -n "${BASH_SOURCE[0]:-}" ] && [ -f "${BASH_SOURCE[0]}" ]; then
  src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$src/bcat.py" ]; then BCAT_SRC="$src"; fi
fi

export PM SUDO BCAT_DIR BIN_DIR BCAT_SRC WANT_ZSH WANT_FISH
export DEBIAN_FRONTEND=noninteractive

RUNNER=""

setup_runner() {
  RUNNER="$(mktemp)"
  cat > "$RUNNER" <<'PY'
import subprocess
import sys
from rich.console import Console
from rich.progress import BarColumn, Progress, SpinnerColumn, TextColumn, TimeElapsedColumn

label, log, cmd = sys.argv[1], sys.argv[2], sys.argv[3]
console = Console()

with open(log, "w") as fh:
    with Progress(
        SpinnerColumn(style="bright_cyan"),
        TextColumn("[bold bright_white]{task.description}"),
        BarColumn(bar_width=30, complete_style="bright_cyan", finished_style="green"),
        TimeElapsedColumn(),
        console=console,
        refresh_per_second=10
    ) as progress:
        task = progress.add_task(label, total=None)
        rc = subprocess.call(["bash", "-c", cmd], stdout=fh, stderr=subprocess.STDOUT)
        progress.update(task, total=1, completed=1)
        mark = "[bold green][+] DONE[/]" if rc == 0 else "[bold red][x] FAILED[/]"
        progress.update(task, description=f"{mark} {label}")

sys.exit(rc)
PY
}

cleanup() {
  [ -n "$RUNNER" ] && rm -f "$RUNNER"
}

trap cleanup EXIT

run_step() {
  local label="$1" cmd="$2" log rc start elapsed spin i

  log="$(mktemp)"
  start="$(date +%s)"

  if [ -n "$RUNNER" ] && command -v python3 >/dev/null 2>&1 && python3 -c "import rich" >/dev/null 2>&1; then
    python3 "$RUNNER" "$label" "$log" "$cmd"
    rc=$?
  else
    printf '\033[1;36m[*]\033[0m %s\n' "$label"

    bash -c "$cmd" >"$log" 2>&1 &
    local pid=$!

    spin='|/-\'
    i=0

    while kill -0 "$pid" 2>/dev/null; do
      elapsed=$(( $(date +%s) - start ))
      printf '\r\033[1;36m[%c]\033[0m %s \033[90m%ss\033[0m' "${spin:i%4:1}" "$label" "$elapsed"
      i=$((i + 1))
      sleep 0.12
    done

    wait "$pid"
    rc=$?

    elapsed=$(( $(date +%s) - start ))

    if [ "$rc" -eq 0 ]; then
      printf '\r\033[1;32m[+] DONE\033[0m %s \033[90m%ss\033[0m\n' "$label" "$elapsed"
    else
      printf '\r\033[1;31m[x] FAILED\033[0m %s \033[90m%ss\033[0m\n' "$label" "$elapsed"
    fi
  fi

  if [ "$rc" -ne 0 ]; then
    printf '\033[1;31m--- Last lines of output ---\033[0m\n'
    tail -n 15 "$log"
  fi

  rm -f "$log"
  return "$rc"
}

run_fn() {
  local label="$1" fn="$2"
  run_step "$label" "$(declare -f); $fn"
}

fn_update() {
  case "$PM" in
    pkg) pkg update -y && pkg upgrade -y ;;
    apt) $SUDO apt-get update && $SUDO apt-get upgrade -y ;;
    pacman) $SUDO pacman -Syu --noconfirm ;;
    dnf) $SUDO dnf upgrade -y ;;
    zypper) $SUDO zypper --non-interactive refresh && $SUDO zypper --non-interactive update -y ;;
    apk) $SUDO apk update && $SUDO apk upgrade ;;
    brew) brew update ;;
  esac
}

fn_python_base() {
  local pkgs

  case "$PM" in
    pkg) pkgs="python python-cryptography" ;;
    apt) pkgs="python3 python3-pip" ;;
    pacman) pkgs="python python-pip" ;;
    dnf) pkgs="python3 python3-pip" ;;
    zypper) pkgs="python3 python3-pip" ;;
    apk) pkgs="python3 py3-pip" ;;
    brew) pkgs="python" ;;
  esac

  case "$PM" in
    pkg) pkg install -y $pkgs ;;
    apt) $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs ;;
    pacman) $SUDO pacman -S --needed --noconfirm $pkgs ;;
    dnf) $SUDO dnf install -y $pkgs ;;
    zypper) $SUDO zypper --non-interactive install $pkgs ;;
    apk) $SUDO apk add $pkgs ;;
    brew) brew install $pkgs ;;
  esac
}

fn_python_libs() {
  python3 -m ensurepip --upgrade >/dev/null 2>&1 || true

  python3 -m pip install -q rich pyfiglet \
    || python3 -m pip install -q --user rich pyfiglet \
    || python3 -m pip install -q --break-system-packages rich pyfiglet \
    || python3 -m pip install -q --user --break-system-packages rich pyfiglet

  python3 -c "import rich, pyfiglet"
}

fn_packages() {
  local pkgs="curl unzip"

  case "$PM" in
    apt|dnf|zypper|pacman|apk) pkgs="$pkgs fontconfig" ;;
  esac

  if [ "$WANT_ZSH" -eq 1 ]; then pkgs="$pkgs zsh"; fi
  if [ "$WANT_FISH" -eq 1 ]; then pkgs="$pkgs fish"; fi

  case "$PM" in
    pkg) pkg install -y $pkgs ;;
    apt) $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs ;;
    pacman) $SUDO pacman -S --needed --noconfirm $pkgs ;;
    dnf) $SUDO dnf install -y $pkgs ;;
    zypper) $SUDO zypper --non-interactive install $pkgs ;;
    apk) $SUDO apk add $pkgs ;;
    brew) brew install $pkgs ;;
  esac
}

fn_eza() {
  if command -v eza >/dev/null 2>&1; then return 0; fi

  case "$PM" in
    pkg) pkg install -y eza ;;
    apt) $SUDO apt install -y eza ;;
    pacman) $SUDO pacman -S --needed --noconfirm eza ;;
    dnf) $SUDO dnf install -y eza ;;
    zypper) $SUDO zypper --non-interactive install eza ;;
    apk) $SUDO apk add eza ;;
    brew) brew install eza ;;
  esac

  if ! command -v eza >/dev/null 2>&1 && command -v cargo >/dev/null 2>&1; then
    cargo install eza
  fi

  command -v eza >/dev/null 2>&1
}

fn_bcat() {
  if [ -z "$BCAT_SRC" ] || [ ! -f "$BCAT_SRC/bcat.py" ]; then
    printf '\033[1;31m[x] bcat.py not found beside install\033[0m\n'
    return 1
  fi

  mkdir -p "$BCAT_DIR/.banner" || return 1

  cp "$BCAT_SRC/bcat.py" "$BCAT_DIR/bcat.py" || return 1
  printf '%s' "$BCAT_SRC" > "$BCAT_DIR/source_dir" || return 1

  if [ -d "$BCAT_SRC/.banner" ]; then
    cp -n "$BCAT_SRC"/.banner/*.txt "$BCAT_DIR/.banner/" 2>/dev/null || true
  fi

  mkdir -p "$BIN_DIR" || return 1
  printf '#!/usr/bin/env bash\nexec python3 "%s" "$@"\n' "$BCAT_DIR/bcat.py" > "$BIN_DIR/bcat" || return 1
  chmod +x "$BIN_DIR/bcat"
}

fn_path() {
  if is_termux; then return 0; fi

  local rc

  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ "$rc" != "$HOME/.bashrc" ] && [ ! -f "$rc" ]; then continue; fi

    touch "$rc" || return 1

    if ! grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$rc"; then
      printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
    fi
  done
}

if [ "$PM" = "none" ]; then
  printf '\033[1;31m[x] No supported package manager found.\033[0m\n'
  exit 1
fi

if [ -n "$SUDO" ]; then
  sudo -v || { printf '\033[1;31m[x] sudo authentication failed.\033[0m\n'; exit 1; }
fi

printf '\033[1;36m'
printf ' ____   ____    _  _____\n'
printf '| __ ) / ___|  / \|_   _|\n'
printf '|  _ \| |     / _ \ | |\n'
printf '| |_) | |___ / ___ \| |\n'
printf '|____/ \____/_/   \_\_|\n'
printf '\033[0m'
printf '\033[1;37mBCAT INSTALLER\033[0m\n'
printf '\033[1;90mDeveloped by W3kout\033[0m\n'
printf '\033[1;36mPackage manager:\033[0m %s\n\n' "$PM"

setup_runner

run_fn "Updating package index" fn_update || true

run_fn "Installing Python" fn_python_base \
  || { printf '\033[1;31m[x] Python installation failed.\033[0m\n'; exit 1; }

if ! command -v python3 >/dev/null 2>&1; then
  printf '\033[1;31m[x] Python 3 was not found after installation.\033[0m\n'
  exit 1
fi

run_fn "Installing Python libraries (rich, pyfiglet)" fn_python_libs \
  || { printf '\033[1;31m[x] Could not install rich and pyfiglet.\033[0m\n'; exit 1; }

run_fn "Installing system packages" fn_packages \
  || printf '\033[1;33m[!] Some system packages failed, continuing.\033[0m\n'

run_fn "Installing eza" fn_eza \
  || printf '\033[1;33m[!] eza is not available. Use option 07 inside bcat later.\033[0m\n'

run_fn "Installing BCAT" fn_bcat \
  || { printf '\033[1;31m[x] BCAT installation failed.\033[0m\n'; exit 1; }

run_fn "Configuring PATH" fn_path || true

python3 - <<'PY'
from rich.console import Console
from rich.panel import Panel
from rich.text import Text

console = Console()
message = Text()
message.append("[+] Done ", style="bold green")
message.append("Now Type ", style="bold white")
message.append("bcat", style="bold bright_cyan")

console.print()
console.print(Panel.fit(message, border_style="bright_red", padding=(0, 2)))
PY
