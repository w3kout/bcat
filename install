
#!/usr/bin/env bash
set -u

printf '\033[2J\033[H'

BCAT_DIR="$HOME/.bcat"
WANT_ZSH=0
WANT_FISH=0

for arg in "$@"; do
  case "$arg" in
    --zsh) WANT_ZSH=1 ;;
    --fish) WANT_FISH=1 ;;
    --all) WANT_ZSH=1; WANT_FISH=1 ;;
    -h|--help) echo "Usage: bash install [--zsh] [--fish] [--all]"; exit 0 ;;
    *) printf '\033[1;31m[x] Unknown option: %s\033[0m\n' "$arg"; exit 1 ;;
  esac
done

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[1;90m'
RESET='\033[0m'

info() { printf "${CYAN}[*]${RESET} %s\n" "$1"; }
success() { printf "${GREEN}[+]${RESET} %s\n" "$1"; }
warning() { printf "${YELLOW}[!]${RESET} %s\n" "$1"; }
error() { printf "${RED}[x]${RESET} %s\n" "$1"; }

have() { command -v "$1" >/dev/null 2>&1; }

is_termux() {
  [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux ]
}

detect_pm() {
  if is_termux; then echo pkg
  elif [ "$(uname -s)" = "Darwin" ]; then
    if have brew; then echo brew; else echo none; fi
  elif have apt-get; then echo apt
  elif have pacman; then echo pacman
  elif have dnf; then echo dnf
  elif have zypper; then echo zypper
  elif have apk; then echo apk
  else echo none
  fi
}

PM="$(detect_pm)"
SUDO=""

if [ "$PM" != "pkg" ] && [ "$PM" != "brew" ] && [ "$(id -u)" -ne 0 ] && have sudo; then
  SUDO="sudo"
fi

if is_termux; then
  BIN_DIR="${PREFIX:-/data/data/com.termux/files/usr}/bin"
else
  BIN_DIR="$HOME/.local/bin"
fi

BCAT_SRC=""

if [ -n "${BASH_SOURCE[0]:-}" ] && [ -f "${BASH_SOURCE[0]}" ]; then
  src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$src/bcat.py" ]; then BCAT_SRC="$src"; fi
fi

export PM SUDO BCAT_DIR BIN_DIR BCAT_SRC WANT_ZSH WANT_FISH
export DEBIAN_FRONTEND=noninteractive

run_fn() {
  local label="$1"
  local fn="$2"

  info "$label"
  if "$fn"; then
    success "$label completed."
    return 0
  else
    error "$label failed."
    return 1
  fi
}

fn_update() {
  case "$PM" in
    pkg) pkg update -y && pkg upgrade -y ;;
    apt) $SUDO apt-get update && $SUDO apt-get upgrade -y ;;
    pacman) $SUDO pacman -Syu --noconfirm ;;
    dnf) $SUDO dnf upgrade -y ;;
    zypper) $SUDO zypper --non-interactive refresh && $SUDO zypper --non-interactive update -y ;;
    apk) $SUDO apk update && $SUDO apk upgrade ;;
    brew) brew update ;;
  esac
}

fn_python_base() {
  case "$PM" in
    pkg) pkg install -y python python-cryptography ;;
    apt) $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y python3 python3-pip ;;
    pacman) $SUDO pacman -S --needed --noconfirm python python-pip ;;
    dnf) $SUDO dnf install -y python3 python3-pip ;;
    zypper) $SUDO zypper --non-interactive install python3 python3-pip ;;
    apk) $SUDO apk add python3 py3-pip ;;
    brew) brew install python ;;
    *) return 1 ;;
  esac
}

fn_packages() {
  local pkgs="curl unzip"

  case "$PM" in
    apt|dnf|zypper|pacman|apk) pkgs="$pkgs fontconfig" ;;
  esac

  if [ "$WANT_ZSH" -eq 1 ]; then pkgs="$pkgs zsh"; fi
  if [ "$WANT_FISH" -eq 1 ]; then pkgs="$pkgs fish"; fi

  case "$PM" in
    pkg) pkg install -y $pkgs ;;
    apt) $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs ;;
    pacman) $SUDO pacman -S --needed --noconfirm $pkgs ;;
    dnf) $SUDO dnf install -y $pkgs ;;
    zypper) $SUDO zypper --non-interactive install $pkgs ;;
    apk) $SUDO apk add $pkgs ;;
    brew) brew install $pkgs ;;
    *) return 1 ;;
  esac
}

fn_eza() {
  if have eza; then return 0; fi

  case "$PM" in
    pkg) pkg install -y eza ;;
    apt) $SUDO apt install -y eza ;;
    pacman) $SUDO pacman -S --needed --noconfirm eza ;;
    dnf) $SUDO dnf install -y eza ;;
    zypper) $SUDO zypper --non-interactive install eza ;;
    apk) $SUDO apk add eza ;;
    brew) brew install eza ;;
    *) return 1 ;;
  esac

  have eza
}

fn_bcat() {
  if [ -z "$BCAT_SRC" ] || [ ! -f "$BCAT_SRC/bcat.py" ]; then
    error "bcat.py not found beside install."
    return 1
  fi

  mkdir -p "$BCAT_DIR/.banner" || return 1

  cp "$BCAT_SRC/bcat.py" "$BCAT_DIR/bcat.py" || return 1
  printf '%s' "$BCAT_SRC" > "$BCAT_DIR/source_dir" || return 1

  if [ -d "$BCAT_SRC/.banner" ]; then
    cp -n "$BCAT_SRC"/.banner/*.txt "$BCAT_DIR/.banner/" 2>/dev/null || true
  fi

  mkdir -p "$BIN_DIR" || return 1
  printf '#!/usr/bin/env bash\nexec python3 "%s" "$@"\n' "$BCAT_DIR/bcat.py" > "$BIN_DIR/bcat" || return 1
  chmod +x "$BIN_DIR/bcat"
}

fn_path() {
  if is_termux; then return 0; fi

  local rc

  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ "$rc" != "$HOME/.bashrc" ] && [ ! -f "$rc" ]; then continue; fi

    touch "$rc" || return 1

    if ! grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$rc"; then
      printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
    fi
  done
}

if [ "$PM" = "none" ]; then
  error "No supported package manager found."
  exit 1
fi

if [ -n "$SUDO" ]; then
  sudo -v || { error "sudo authentication failed."; exit 1; }
fi

printf "${CYAN}"
printf ' ____   ____    _  _____\n'
printf '| __ ) / ___|  / \\|_   _|\n'
printf '|  _ \\| |     / _ \\ | |\n'
printf '| |_) | |___ / ___ \\| |\n'
printf '|____/ \\____/_/   \\_\\_| \n'
printf "${RESET}"
printf "${WHITE}BCAT INSTALLER${RESET}\n"
printf "${GRAY}Developed by W3kout${RESET}\n"
printf "${CYAN}Package manager:${RESET} %s\n\n' "$PM"

run_fn "Updating package index" fn_update || exit 1

run_fn "Installing Python" fn_python_base || exit 1

if ! have python3; then
  error "Python 3 was not found after installation."
  exit 1
fi

run_fn "Installing system packages" fn_packages || warning "Some system packages failed."

run_fn "Installing eza" fn_eza || warning "eza is not available. Use option 07 inside bcat later."

run_fn "Installing BCAT" fn_bcat || exit 1

run_fn "Configuring PATH" fn_path || warning "Could not configure PATH automatically."

printf '\n'
success "BCAT installation completed."
printf "${WHITE}Now Type ${CYAN}bcat${RESET}\n"
